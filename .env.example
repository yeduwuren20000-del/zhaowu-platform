# DevServerManager 环境变量清单
#
# 本项目零运行时依赖，不引入 dotenv：下面的变量需要导出到「进程环境」才会生效。
#   PowerShell :  $env:DSM_PORT='8787';  npm start
#   CMD        :  set DSM_PORT=8787 && npm start
#   持续生效    :  系统设置 → 环境变量，或自己写一个 start 脚本
# 复制本文件为 .env 只是给自己做备忘，程序不会自动读取它。
# 注意：这里不要写任何真实密码。SSH 密码/私钥口令见 data/secrets.example.json。

# ---------- 服务监听 ----------
# API 端口，默认 8787（start.bat / dev.bat / Vite 代理都指向它）
DSM_PORT=8787
# 监听地址，默认 127.0.0.1（只对本机开放；改成 0.0.0.0 前请自行评估风险）
DSM_HOST=127.0.0.1

# ---------- 数据与日志 ----------
# 数据目录（projects/servers/runtime/discovery/events.json 与 logs/），默认 <项目根>/data
# DSM_DATA_DIR=D:\dev\dsm-data

# ---------- 启动脚本行为（scripts/start.mjs / dev.mjs）----------
# 强制重新构建前端，默认不设置（缺产物才构建）
# DSM_FORCE_BUILD=1
# 启动后不自动打开浏览器
# DSM_NO_OPEN=1

# ---------- 自动发现 ----------
# 启动时是否自动扫描一次本机监听表，默认开启；设为 0 关闭
DSM_DISCOVERY_ON_STARTUP=1

# ---------- SSH / Docker 只读采集 ----------
# 同时进行的 SSH 采集上限，默认 3
DSM_SSH_CONCURRENCY=3
# 按服务器命名的凭据（ID 大写、非字母数字转下划线），二选一：
# 这里写变量名，值放在真实环境变量里，不要提交
# DSM_SSH_PASSWORD_SRV_XXXXXXXX=
# DSM_SSH_PASSPHRASE_SRV_XXXXXXXX=

# ---------- 事件时间线 ----------
# 生命周期事件最多保留多少条，默认 800（最小 50）
DSM_EVENT_MAX=800

# ---------- AI 辅助识别（可选，默认完全关闭）----------
# 不配置 API Key 时规则层照常工作，不会发起任何外部请求
# DSM_AI_API_KEY=
# DSM_AI_MODEL=
# DSM_AI_BASE_URL=
# 单次扫描最多调用多少个候选，默认 8
# DSM_AI_MAX=8
# 单次调用超时（毫秒），默认 20000（最小 3000）
# DSM_AI_TIMEOUT_MS=20000
# 并发数，默认 2
# DSM_AI_CONCURRENCY=2

# ---------- 本地演示用的假 SSH 服务器（server/test/ssh-fixture-server.mjs）----------
# 种子数据里的「Demo Linux（本地假 SSH）」用它，仅本机演示，不是真实凭据
# DSM_FIXTURE_PASSWORD=fixture-pass
