# 依赖与构建产物
node_modules/
web/dist/
.npm-cache/

# Python 环境与模型权重：体积大、跟机器绑死，克隆后按 README 自建
.venv/
**/.venv/
__pycache__/
*.pyc
*.pth
*.onnx

# 本地影院：片库是自己的媒体文件，运行缓存随时可再生
tools/mediaserver/library/
tools/mediaserver/.cache/

# 超分引擎二方包（51MB 二进制 + 模型，由 tools/upscaler/setup.bat 自动下载）
tools/upscaler/tools/realesrgan/

# 测试残留（构建/单测中途失败会留下临时产物，不是源码）
web/.tmp-unit-*/
web/dist-test/

# 运行数据：项目/服务器/端口/事件/日志全部是本机私有状态，一律不提交
# （首次启动会自动生成种子数据，见 server/src/store/*.js）
#
# ★★★ 安全红线（任何优化 / 清理 / 重构都禁止违反）★★★
# 本目录含凭据库密文 data/vault.dsmv 与自动快照 data/vault-backups/，以及其它本机私有状态。
# 切勿执行 `git clean -fdx` —— 带 -x 会删除被忽略的 data/，直接抹掉凭据库与全部运行数据！
# 同样禁止 `git stash -a` / `git stash --all`，以及任何 `rm` / `Remove-Item data/`。
# 凭据防丢失靠两条：① 本段忽略规则（git 永远碰不到 data/）；
# ② 应用层 server/src/services/vaultService.js 的 writeVaultFile 在「每次覆盖写之前」自动快照到 vault-backups（保留 20 份）。
data/*
!data/secrets.example.json

# 凭据：只允许提交 .example 模板
.env
.env.local
*.env
!.env.example
secrets.json

# 仓储自身的临时与备份文件
*.tmp
*.bak-*
*.corrupt-*
*.local
# clear-demo 生成的整目录备份
data-backup-*/

# 日志与缓存
*.log
npm-debug.log*
coverage/

# 编辑器与系统
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# 截图与调试输出（ui-snapshot / _e2e-*.mjs 生成，不进仓库）
.shots/
**/.shots/
